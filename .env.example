# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Sarvam AI key. Leave empty to use edge-tts (free, no key) only.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
SARVAM_LANGUAGE=en-IN
SARVAM_PACE=1.0

# Fallback voice used when Sarvam fails or no key is set
EDGE_VOICE=en-IN-NeerjaNeural

# Say "<name> says:" before a message (skipped when the same person sends several in a row)
SAY_NAMES=true

# Longer messages are cut off at this many characters
MAX_CHARS=300

# Optional comma-separated text channel IDs to read from, in addition to the voice channel's own chat
TTS_CHANNEL_IDS=
