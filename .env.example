# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Sarvam AI key. Leave empty to use edge-tts (free, no key) only.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_LANGUAGE=hi-IN
SARVAM_PACE=1.0

# Text channel to read from (name or ID)
TTS_CHANNEL=general

# Fallback voices used when Sarvam fails, matched to the user's Sarvam voice gender
EDGE_MALE_VOICE=hi-IN-MadhurNeural
EDGE_FEMALE_VOICE=hi-IN-SwaraNeural

# Say the sender's name before their message (skipped when the same person sends several in a row)
SAY_NAMES=false

# Longer messages are cut off at this many characters
MAX_CHARS=300
